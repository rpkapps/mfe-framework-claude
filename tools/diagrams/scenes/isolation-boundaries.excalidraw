      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1690225763,
      "version": 1,
      "versionNonce": 1428185178,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1735689600000,
      "link": null,
      "locked": false,
      "index": "aK",
      "id": "isolation-boundaries-text-21",
      "type": "text",
      "x": 14,
      "y": 646,
      "width": 271.26000000000005,
      "height": 90,
      "text": "The generated #mfe/fetch resolves a relative\nrequest against the base URL that\nruntime-config.json supplied, and attaches the\nshell’s session token to the origins declared\n{ api: true }: an exact scheme, host and port\nset, with no wildcards and no substrings.",
