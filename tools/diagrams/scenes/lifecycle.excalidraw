      "index": "a5",
      "id": "lifecycle-text-06",
      "type": "text",
      "x": 14,
      "y": 212,
      "width": 195.868,
      "height": 172.5,
      "text": "React Suspense shows the pending\nslot while the container is\nfetched: the shell’s “Loading\noperations”, or the pending prop\na Widget’s consumer passed.\n\nOne load per container per\nruntime, shared by every waiter\nand cached, a rejection included.\n\nThere is no time budget. The load\nsuspends until it settles.",
      "originalText": "React Suspense shows the pending\nslot while the container is\nfetched: the shell’s “Loading\noperations”, or the pending prop\na Widget’s consumer passed.\n\nOne load per container per\nruntime, shared by every waiter\nand cached, a rejection included.\n\nThere is no time budget. The load\nsuspends until it settles.",
      "fontSize": 11.5,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
