      "id": "lifecycle-text-17",
      "type": "text",
      "x": 890,
      "y": 184.75,
      "width": 160.90099999999998,
      "height": 16.25,
      "text": "AppMount / WidgetMount",
      "originalText": "AppMount / WidgetMount",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1878252988,
      "version": 1,
      "versionNonce": 1030535134,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1735689600000,
      "link": null,
      "locked": false,
      "index": "aH",
      "id": "lifecycle-text-18",
      "type": "text",
      "x": 890,
      "y": 212,
      "width": 196.7305,
      "height": 129.375,
      "text": "The App routes inside its own\nboundary. A Widget validates every\ncommitted input change, and every\nevent it emits.\n\nA rejected input keeps the last\none that passed and reports a\ndiagnostic. It never blanks a\nWidget already on the page.",
      "originalText": "The App routes inside its own\nboundary. A Widget validates every\ncommitted input change, and every\nevent it emits.\n\nA rejected input keeps the last\none that passed and reports a\ndiagnostic. It never blanks a\nWidget already on the page.",
      "fontSize": 11.5,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "angle": 0,
