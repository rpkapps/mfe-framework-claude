      "locked": false,
      "index": "aD",
      "id": "lifecycle-text-14",
      "type": "text",
      "x": 598,
      "y": 212,
      "width": 198.05300000000003,
      "height": 143.75,
      "text": "An effect creates it and the same\neffect’s cleanup destroys it, so\none render passes with no mount.\n\nA mount token, the scope root and\nthe style root, an overlay root in\nthe document, a tracer, a Query\nclient, the definition’s two\nstorage areas, and the AbortSignal\nuseMfeSignal hands the author.",
      "originalText": "An effect creates it and the same\neffect’s cleanup destroys it, so\none render passes with no mount.\n\nA mount token, the scope root and\nthe style root, an overlay root in\nthe document, a tracer, a Query\nclient, the definition’s two\nstorage areas, and the AbortSignal\nuseMfeSignal hands the author.",
      "fontSize": 11.5,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
