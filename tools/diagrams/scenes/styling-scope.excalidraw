      "id": "styling-scope-text-10",
      "type": "text",
      "x": 514,
      "y": 190,
      "width": 259.875,
      "height": 65.625,
      "text": "@layer theme, base, components, utilities;\n@import \"tailwindcss/theme.css\" layer(theme);\n@import \"tailwindcss/utilities.css\"\n  layer(utilities);\n@import \"@tecton/react/styles/scoped.css\";",
      "originalText": "@layer theme, base, components, utilities;\n@import \"tailwindcss/theme.css\" layer(theme);\n@import \"tailwindcss/utilities.css\"\n  layer(utilities);\n@import \"@tecton/react/styles/scoped.css\";",
      "fontSize": 10.5,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1595158613,
      "version": 1,
      "versionNonce": 1407901603,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1735689600000,
      "link": null,
      "locked": false,
      "index": "aA",
      "id": "styling-scope-text-11",
      "type": "text",
      "x": 514,
      "y": 286,
      "width": 285.06249999999994,
      "height": 62.5,
      "text": "Deliberately not @import \"tailwindcss\", which\nwould bring preflight with it. Tailwind emits\na utility only for a class it has seen, so this\nis the CSS for this container and nothing else.",
      "originalText": "Deliberately not @import \"tailwindcss\", which\nwould bring preflight with it. Tailwind emits\na utility only for a class it has seen, so this\nis the CSS for this container and nothing else.",
      "fontSize": 12.5,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
