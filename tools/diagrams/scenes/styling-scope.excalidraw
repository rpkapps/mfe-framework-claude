    },
    {
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1348056334,
      "version": 1,
      "versionNonce": 1031715094,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1735689600000,
      "link": null,
      "locked": false,
      "index": "aF",
      "id": "styling-scope-text-16",
      "type": "text",
      "x": 1014,
      "y": 268,
      "width": 280.3125,
      "height": 78.125,
      "text": "The lower boundary is the next mount root\nbelow, so a nested container’s CSS is never\nthis one’s. :root and :host are rewritten onto\nthe scope root, and @keyframes are renamed\nafter this container.",
      "originalText": "The lower boundary is the next mount root\nbelow, so a nested container’s CSS is never\nthis one’s. :root and :host are rewritten onto\nthe scope root, and @keyframes are renamed\nafter this container.",
      "fontSize": 12.5,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
