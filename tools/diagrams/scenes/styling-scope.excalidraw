      "id": "styling-scope-text-15",
      "type": "text",
      "x": 1014,
      "y": 190,
      "width": 248.05,
      "height": 55,
      "text": "@scope ([data-mfe-scope=\"operations\"])\n    to ([data-mfe-scope]) {\n  /* every rule this container emitted */\n}",
      "originalText": "@scope ([data-mfe-scope=\"operations\"])\n    to ([data-mfe-scope]) {\n  /* every rule this container emitted */\n}",
      "fontSize": 11,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
