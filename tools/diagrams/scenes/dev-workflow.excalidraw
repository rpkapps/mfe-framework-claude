      "id": "dev-workflow-text-21",
      "type": "text",
      "x": 894,
      "y": 190,
      "width": 254.1,
      "height": 110,
      "text": "const key = 'company:mfe:overrides'\nconst overrides = JSON.parse(\n  localStorage.getItem(key) || '{}')\noverrides['operations'] =\n  'http://localhost:3001/mf-manifest.json'\nlocalStorage.setItem(key,\n  JSON.stringify(overrides))\nlocation.reload()",
      "originalText": "const key = 'company:mfe:overrides'\nconst overrides = JSON.parse(\n  localStorage.getItem(key) || '{}')\noverrides['operations'] =\n  'http://localhost:3001/mf-manifest.json'\nlocalStorage.setItem(key,\n  JSON.stringify(overrides))\nlocation.reload()",
      "fontSize": 11,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "angle": 0,
      "strokeColor": "#1e1e1e",
