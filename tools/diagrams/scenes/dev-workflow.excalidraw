      "type": "text",
      "x": 894,
      "y": 320,
      "width": 323.0399999999999,
      "height": 45,
      "text": "The reload is not optional: the old container is already\nregistered under the same name, and disposing a mount\ndoes not reach it.",
      "originalText": "The reload is not optional: the old container is already\nregistered under the same name, and disposing a mount\ndoes not reach it.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
