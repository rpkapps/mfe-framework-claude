{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "types": ["node"],
    // The React side keeps the base configuration's `react-jsx`. The Angular test components are
    // decorated classes, and Angular's decorators are the legacy proposal.
    "experimentalDecorators": true,
    // Define semantics would shadow the input and output members Angular sets up on the instance.
    "useDefineForClassFields": false
  },
  "include": ["src/**/*", "vitest.setup.ts", "*.config.ts"]
}
