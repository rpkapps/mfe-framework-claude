# Copy to tools/agent-dev/.env (git-ignored) and uncomment one model. `pnpm dev` and
# `pnpm --filter @company/agent-dev start` read it; a variable set in the shell wins over the file.
# With neither model set, the demo agent answers: a script, no key, no network.

# A model behind an OpenAI-compatible server (vLLM, SGLang, llama.cpp, Ollama, LM Studio),
# on your machine or network. The base URL includes /v1; tool calling must be on in the server.
# AGENT_DEV_OPENAI_URL=http://192.168.1.20:8000/v1
# AGENT_DEV_MODEL=deepseek-v4.1-flash
# AGENT_DEV_API_KEY=

# Anthropic's Messages API (used when AGENT_DEV_OPENAI_URL is not set).
# ANTHROPIC_API_KEY=
# AGENT_DEV_MODEL=
