{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // No rootDir: the shared vitest setup in "include" is the one place the
    // jest-dom matchers are extended and declared, and it lives in the package
    // that owns them rather than being copied into each example.
    "types": ["node"],
    "paths": {
      "#mfe/config": ["./.mfe/config.ts"],
      "#mfe/fetch": ["./.mfe/fetch.ts"],
      "#mfe/meta": ["./.mfe/meta.ts"]
    }
  },
  "include": ["src/**/*", ".mfe/**/*", "*.config.ts", "../../packages/mfe-react/vitest.setup.ts"]
}
