{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    /*
     * @tecton/react ships built `.d.ts` files now, but it is still a
     * `link:`ed checkout, so TypeScript resolves the symlink to the checkout
     * itself. The packages its files import bare (react, @base-ui/react,
     * recharts, …) have to be pointed back at this workspace's copies. This is
     * the type-level counterpart of `tectonResolve` in the build.
     */
    "paths": {
      "#mfe/config": ["./.mfe/config.ts"],
      "#mfe/fetch": ["./.mfe/fetch.ts"],
      "#mfe/meta": ["./.mfe/meta.ts"],
      "#mfe/user-context": ["./.mfe/user-context/lab.ts"],
      "#mfe/user-context/fieldwork": ["../fieldwork/.mfe/user-context/fieldwork.ts"],
      "#mfe/user-context/well-inspection": ["../fieldwork/.mfe/user-context/well-inspection.ts"],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "react/jsx-dev-runtime": ["./node_modules/@types/react/jsx-dev-runtime"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/client": ["./node_modules/@types/react-dom/client"],
      "@base-ui/react": ["./node_modules/@base-ui/react"],
      "@base-ui/react/*": ["./node_modules/@base-ui/react/*"],
      "react-resizable-panels": ["./node_modules/react-resizable-panels"],
      "class-variance-authority": ["./node_modules/class-variance-authority"],
      "cn": ["./node_modules/cn"],
      "recharts": ["./node_modules/recharts"]
    }
  },
  "include": ["src/**/*", ".mfe/**/*", "*.config.ts", "../../packages/mfe-react/vitest.setup.ts"]
}
