{
  "name": "fieldwork",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "src",
  "targets": {
    "generate": {
      "executor": "@company/mfe-nx:generate",
      "cache": false
    },
    "build": {
      "executor": "@nx/angular:webpack-browser",
      "dependsOn": ["generate", "^build"],
      "outputs": ["{options.outputPath}"],
      "cache": true,
      "options": {
        "outputPath": "dist",
        "index": "src/index.html",
        "main": ".mfe/entries/container.ts",
        "tsConfig": "tsconfig.app.json",
        "polyfills": [],
        "assets": [
          {
            "glob": "**/*",
            "input": "public"
          }
        ],
        "styles": [],
        "scripts": [],
        "customWebpackConfig": {
          "path": "webpack.config.ts"
        }
      },
      "configurations": {
        "production": {
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "namedChunks": false,
          "extractLicenses": true
        },
        "development": {
          "optimization": false,
          "outputHashing": "none",
          "sourceMap": true,
          "namedChunks": true,
          "extractLicenses": false,
          "buildOptimizer": false,
          "vendorChunk": false
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@nx/angular:dev-server",
      "dependsOn": ["generate"],
      "options": {
        "port": 3007,
        "headers": {
          "Access-Control-Allow-Origin": "*"
        }
      },
      "configurations": {
        "production": {
          "buildTarget": "fieldwork:build:production"
        },
        "development": {
          "buildTarget": "fieldwork:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate"],
      "options": {
        "command": "vitest run",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate"],
      "options": {
        "command": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate"],
      "options": {
        "command": "eslint .",
        "cwd": "{projectRoot}"
      }
    }
  },
  "tags": []
}
