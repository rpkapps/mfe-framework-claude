{
  "name": "@company/mfe-framework",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "check": "pnpm run build && pnpm run generate && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run boundaries && pnpm run test",
    "generate": "pnpm -r run generate && node tools/dev/build-registry.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && pnpm -r run typecheck",
    "boundaries": "node tools/boundaries/check-boundaries.mjs",
    "diagrams:render": "node tools/diagrams/render.mjs",
    "diagrams:check": "node tools/diagrams/render.mjs --check",
    "test": "vitest run && pnpm --filter @example/fieldwork run test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "pnpm run build && node tools/dev/dev.mjs",
    "dev:shell": "pnpm run build && pnpm --filter @company/shell dev",
    "dev:mfes": "pnpm run build && node tools/dev/dev.mjs --only-mfes",
    "docs:dev": "pnpm run build && pnpm --filter @company/docs dev",
    "docs:build": "pnpm run build && pnpm --filter @company/docs build",
    "docs:preview": "pnpm --filter @company/docs preview",
    "build:mfes": "pnpm run build && pnpm -r --filter \"./examples/*\" run build",
    "verify:page": "pnpm run build && pnpm run generate && node tools/dev/verify-page.mjs",
    "hmr:probe": "node tools/dev/hmr-probe.mjs",
    "changeset": "changeset",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@company/eslint-plugin-mfe": "workspace:*",
    "@excalidraw/excalidraw": "catalog:",
    "@playwright/test": "catalog:",
    "@rsbuild/core": "catalog:",
    "@tanstack/eslint-plugin-query": "catalog:",
    "@tanstack/eslint-plugin-router": "catalog:",
    "@tanstack/router-generator": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "concurrently": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "jiti": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "intent": {
    "skills": [
      "@tecton/react"
    ]
  }
}
