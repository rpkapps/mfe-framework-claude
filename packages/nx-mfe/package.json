{
  "name": "@company/nx-mfe",
  "version": "0.1.0",
  "description": "Nx generators that scaffold an Angular 19 (zoneless) MFE container: nx g @company/nx-mfe:app and :widget.",
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "generators": "./generators.json",
  "exports": {
    "./package.json": "./package.json",
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist",
    "generators.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-templates.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@nx/devkit": ">=20.0.0 <24.0.0"
  },
  "devDependencies": {
    "@nx/devkit": "catalog:",
    "@types/node": "catalog:",
    "nx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
