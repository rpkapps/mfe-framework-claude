{
  "name": "@company/mfe-runtime",
  "version": "0.1.0",
  "description": "Neutral MFE runtime: reading the registry through the adapter interface, loading and mount orchestration, retry, disposal, deadlines, shell state, validated storage, commands, breadcrumbs, navigation bridge, auth token single-flight and telemetry binding. No React, router, single-spa or Module Federation dependency.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./testing/mfe-config": {
      "types": "./dist/testing/generated/config.d.ts",
      "default": "./dist/testing/generated/config.js"
    },
    "./testing/mfe-fetch": {
      "types": "./dist/testing/generated/fetch.d.ts",
      "default": "./dist/testing/generated/fetch.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@company/mfe-core": "workspace:*"
  },
  "peerDependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
