{
  "name": "@company/mfe-runtime",
  "version": "0.1.0",
  "description": "Neutral MFE runtime: reading the registry through the adapter interface, loading and mount orchestration, retry, disposal, deadlines, shell state, validated storage, actions, breadcrumbs, navigation bridge, auth token single-flight and telemetry binding. No React, router, single-spa or Module Federation dependency.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "mfe-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "mfe-source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./testing/mfe-config": {
      "mfe-source": "./src/testing/generated/config.ts",
      "types": "./dist/testing/generated/config.d.ts",
      "default": "./dist/testing/generated/config.js"
    },
    "./testing/mfe-fetch": {
      "mfe-source": "./src/testing/generated/fetch.ts",
      "types": "./dist/testing/generated/fetch.d.ts",
      "default": "./dist/testing/generated/fetch.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:stale": "node ../../tools/workspace/require-built.mjs --quiet || pnpm run build",
    "build:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "prepack": "node ../../tools/workspace/require-built.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@company/mfe-core": "workspace:*"
  },
  "peerDependencies": {
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
