{
  "name": "@company/mfe-angular",
  "version": "0.1.0",
  "description": "Angular 19 (zoneless) author and host surface for the MFE framework: createApp, createWidget, route data, injectables over the shell's services, a boundary location strategy, the mfe-widget and mfe-app-host components over the runtime's mountDefinition, and self-mounting definitions any host places into an element.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "default": "./dist/registry/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./testing/mfe-config": {
      "types": "./dist/testing/generated/config.d.ts",
      "default": "./dist/testing/generated/config.js"
    },
    "./testing/mfe-fetch": {
      "types": "./dist/testing/generated/fetch.d.ts",
      "default": "./dist/testing/generated/fetch.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "ngc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@company/mfe-core": "workspace:*",
    "@company/mfe-runtime": "workspace:*"
  },
  "peerDependencies": {
    "@angular/common": "catalog:",
    "@angular/core": "catalog:",
    "@angular/platform-browser": "catalog:",
    "@angular/router": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@angular/common": "catalog:",
    "@angular/compiler": "catalog:",
    "@angular/compiler-cli": "catalog:",
    "@angular/core": "catalog:",
    "@angular/platform-browser": "catalog:",
    "@angular/router": "catalog:",
    "jsdom": "catalog:",
    "rxjs": "catalog:",
    "typescript": "catalog:angular",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
