{
  "name": "@company/mfe-legacy-angular",
  "version": "0.1.0",
  "description": "Removable legacy adapter: reads legacy Angular registry entries into typed registry entries and preserves the existing registerRemotes / loadRemote('<name>/single-spa-app') / ParcelComponent lifecycle.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "mfe-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./angular": {
      "mfe-source": "./src/angular/index.ts",
      "types": "./dist/angular/index.d.ts",
      "default": "./dist/angular/index.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:stale": "node ../../tools/workspace/require-built.mjs --quiet || pnpm run build",
    "prepack": "node ../../tools/workspace/require-built.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@company/mfe-core": "workspace:*",
    "@company/mfe-runtime": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "zod": "^4.2.0"
  }
}
