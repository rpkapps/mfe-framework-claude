{
  "name": "@company/mfe-legacy-angular",
  "version": "0.1.0",
  "description": "Removable legacy adapter: translates legacy Angular registry entries into neutral records and preserves the existing registerRemotes / loadRemote('<name>/single-spa-app') / ParcelComponent lifecycle.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./angular": {
      "types": "./src/angular/index.ts",
      "default": "./src/angular/index.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@company/mfe-core": "workspace:*",
    "@company/mfe-host": "workspace:*"
  },
  "peerDependencies": {
    "single-spa": "catalog:"
  },
  "peerDependenciesMeta": {
    "single-spa": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
