{
  "name": "@company/eslint-plugin-mfe",
  "version": "0.1.0",
  "description": "Shared flat-config ESLint presets (framework, author) and MFE-specific rules. Development-only; never part of the runtime import DAG.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.ts",
      "default": "./src/react.ts"
    },
    "./angular": {
      "types": "./src/angular.ts",
      "default": "./src/angular.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "typescript-eslint": "catalog:"
  },
  "peerDependencies": {
    "eslint": "^9.18.0 || ^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "@tanstack/eslint-plugin-query": "^5.103.0",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@angular-eslint/eslint-plugin": ">=19 <23",
    "@angular-eslint/eslint-plugin-template": ">=19 <23",
    "@angular-eslint/template-parser": ">=19 <23"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "@tanstack/eslint-plugin-query": {
      "optional": true
    },
    "@tanstack/eslint-plugin-router": {
      "optional": true
    },
    "@angular-eslint/eslint-plugin": {
      "optional": true
    },
    "@angular-eslint/eslint-plugin-template": {
      "optional": true
    },
    "@angular-eslint/template-parser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "catalog:",
    "@angular-eslint/eslint-plugin-template": "catalog:",
    "@angular-eslint/template-parser": "catalog:",
    "@tanstack/eslint-plugin-query": "catalog:",
    "@tanstack/eslint-plugin-router": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
