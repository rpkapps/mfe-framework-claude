{
  "name": "@company/mfe-core",
  "version": "0.1.0",
  "description": "Internal to the MFE framework: do not import it. Apps, Widgets and shells import every type from their adapter (@company/mfe-react or @company/mfe-angular). Neutral MFE contracts: identity, lifecycle, structured errors, Widget contracts, telemetry and tracing types, storage envelopes.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "mfe-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime-compatibility": {
      "mfe-source": "./src/runtime-compatibility.ts",
      "types": "./dist/runtime-compatibility.d.ts",
      "default": "./dist/runtime-compatibility.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:stale": "node ../../tools/workspace/require-built.mjs --quiet || pnpm run build",
    "prepack": "node ../../tools/workspace/require-built.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
