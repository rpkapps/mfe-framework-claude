{
  "name": "@company/mfe-devtools",
  "version": "0.1.0",
  "description": "Developer tools overlay for an MFE shell: a flag-gated, lazy-loaded panel that sets the boot-time manifest overrides and shows what the registry accepted.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "mfe-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:stale": "node ../../tools/workspace/require-built.mjs --quiet || pnpm run build",
    "prepack": "node ../../tools/workspace/require-built.mjs",
    "typecheck": "node ../../tools/tecton/typecheck.mjs packages/mfe-devtools",
    "test": "vitest run"
  },
  "dependencies": {
    "@company/mfe-core": "workspace:*",
    "@company/mfe-runtime": "workspace:*",
    "@company/mfe-react": "workspace:*"
  },
  "peerDependencies": {
    "@tecton/react": "*",
    "lucide-react": "^1.45.0",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tecton/react": "*",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.45.0",
    "react": "catalog:",
    "react-aria-components": "^1.21.1",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
