{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // Emitted against the dist/ of the packages it depends on, which the build compiles first.
    "customConditions": [],
    "emitDeclarationOnly": false,
    "outDir": "dist",
    "rootDir": "src"
    // Declarations are emitted because a published consumer's `types` resolve to them. Every
    // export annotates its type, so none has to name a type from the design system's `.d.ts`.
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/__tests__/**"]
}
