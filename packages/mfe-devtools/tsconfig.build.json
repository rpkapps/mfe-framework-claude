{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // Emitted against the dist/ of the packages it depends on, which the build compiles first.
    "customConditions": [],
    "emitDeclarationOnly": false,
    "outDir": "dist",
    "rootDir": "src",

    /*
     * No declarations. Nothing consumes `dist` — every consumer resolves this
     * package's `exports`, which point at `src` — and emitting them here means
     * naming types that come out of the design system's own `.d.ts`, which
     * TypeScript cannot always write a name for from this package's vantage
     * point. The JavaScript is the only artefact this build is for.
     */
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/__tests__/**"]
}
