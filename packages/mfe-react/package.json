{
  "name": "@company/mfe-react",
  "version": "0.1.0",
  "description": "React author and host surface for the MFE framework: createApp, createWidget, lazyWidget, mfeRoute, AppHost and DynamicWidget over the runtime's mountDefinition, shell-state and service hooks, and the style root a container's build attaches to its definition; /host re-exports the runtime for a React shell, /registry is the adapter alone.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./host": {
      "types": "./src/host/index.ts",
      "default": "./src/host/index.ts"
    },
    "./registry": {
      "types": "./src/registry/index.ts",
      "default": "./src/registry/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.tsx",
      "default": "./src/testing/index.tsx"
    },
    "./testing/mfe-config": {
      "types": "./src/testing/generated/config.ts",
      "default": "./src/testing/generated/config.ts"
    },
    "./testing/mfe-fetch": {
      "types": "./src/testing/generated/fetch.ts",
      "default": "./src/testing/generated/fetch.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@company/mfe-core": "workspace:*",
    "@company/mfe-runtime": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
