import { ChangeDetectionStrategy, Component, signal } from '@angular/core'
import { injectUser } from '@company/mfe-angular'
import { Button } from 'primeng/button'
import { Select, type SelectChangeEvent } from 'primeng/select'

interface Region {
  readonly label: string
  readonly value: string
}

@Component({
  selector: '<%= id %>-overview',
  imports: [Button, Select],
  changeDetection: ChangeDetectionStrategy.OnPush,
  template: `
    <section>
      <h1><%= id %></h1>
      <p>Signed in as {{ user()?.name ?? 'nobody' }}.</p>
      <p-select
        [options]="regions"
        optionLabel="label"
        optionValue="value"
        placeholder="Choose a region"
        (onChange)="selectRegion($event)"
      />
      <p-button label="Refresh" [disabled]="region() === null" (onClick)="refresh()" />
      <p>Refreshed {{ refreshes() }} times.</p>
    </section>
  `,
  styles: [`
    section { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; padding: 1rem; }
    h1 { font-size: 1.25rem; font-weight: 600; }
  `],
})
export class OverviewComponent {
  // A field initialiser is an injection context, so injectUser() can be called here directly.
  protected readonly user = injectUser()

  // PrimeNG's `options` input is a mutable array.
  protected readonly regions: Region[] = [
    { label: 'North', value: 'north' },
    { label: 'South', value: 'south' },
  ]

  // Zoneless: state that renders lives in signals.
  protected readonly region = signal<string | null>(null)
  protected readonly refreshes = signal(0)

  protected selectRegion(event: SelectChangeEvent): void {
    this.region.set(typeof event.value === 'string' ? event.value : null)
  }

  protected refresh(): void {
    this.refreshes.update(count => count + 1)
  }
}
