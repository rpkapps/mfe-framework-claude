/*
 * Global styles for this container. Angular inlines component styles itself, so only this
 * stylesheet goes through the build's PostCSS pipeline and scoping. `withMfe` appends the
 * `postcss-loader` rule that compiles it; the Tailwind source glob for an Angular container
 * covers every TypeScript and HTML file under src, so classes used in a component's inline
 * template are kept.
 */
@import 'tailwindcss';
