import { mountWidget } from '@company/mfe-angular/testing'
import { expect, it } from 'vitest'

import { <%= camel %> } from './mfe'

// vitest.setup.ts disposes every mount after each test.
it('emits a validated output when activated', async () => {
  const mounted = await mountWidget(<%= camel %>, { inputs: { label: 'Run' } })

  mounted.element.querySelector<HTMLButtonElement>('p-button button')?.click()
  await mounted.whenStable()

  expect(mounted.outputs.map(output => output.name)).toEqual(['activated'])
})

it('renders its label on a PrimeNG button', async () => {
  const mounted = await mountWidget(<%= camel %>, { inputs: { label: 'Run' } })

  expect(mounted.element.querySelector('p-button')?.textContent).toContain('Run')
})
