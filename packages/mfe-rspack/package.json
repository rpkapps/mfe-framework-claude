{
  "name": "@company/mfe-rspack",
  "version": "0.1.0",
  "description": "pluginMfe(): definition and capability discovery, generated #mfe/* modules, container-relative assets, the container's own scoped stylesheet, React Compiler integration and Module Federation plumbing for MFE containers, as an Rsbuild plugin.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "bin": {
    "mfe-generate": "./dist/cli/generate.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "mfe-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./env": {
      "mfe-source": "./src/config/env.ts",
      "types": "./dist/config/env.d.ts",
      "default": "./dist/config/env.js"
    },
    "./federation": {
      "mfe-source": "./src/federation/host-shared.ts",
      "types": "./dist/federation/host-shared.d.ts",
      "default": "./dist/federation/host-shared.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:stale": "node ../../tools/workspace/require-built.mjs --quiet || pnpm run build",
    "prepack": "node ../../tools/workspace/require-built.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/core": "catalog:",
    "@company/mfe-build": "workspace:*",
    "@company/mfe-core": "workspace:*",
    "@module-federation/enhanced": "catalog:",
    "@tanstack/router-generator": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "babel-loader": "catalog:",
    "babel-plugin-react-compiler": "catalog:"
  },
  "peerDependencies": {
    "@rsbuild/core": "^2.2.0",
    "@rspack/core": "^2.2.0",
    "@tecton/react": ">=0.1.0",
    "typescript": ">=5.5.0 <7.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@company/mfe-runtime": "workspace:*",
    "@module-federation/runtime": "catalog:",
    "@rsbuild/core": "catalog:",
    "@rspack/core": "catalog:",
    "@tecton/react": "*",
    "@types/node": "catalog:",
    "postcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
