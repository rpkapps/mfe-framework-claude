{
  "name": "@company/mfe-rspack",
  "version": "0.1.0",
  "description": "pluginMfe(): definition and capability discovery, generated #mfe/* modules, container-relative assets, the container's own scoped stylesheet, React Compiler integration and Module Federation plumbing for MFE containers, as an Rsbuild plugin.",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "mfe-generate": "./src/cli/generate.ts"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./env": {
      "types": "./src/config/env.ts",
      "default": "./src/config/env.ts"
    },
    "./federation": {
      "types": "./src/federation/host-shared.ts",
      "default": "./src/federation/host-shared.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/core": "catalog:",
    "@company/mfe-build": "workspace:*",
    "@company/mfe-core": "workspace:*",
    "@module-federation/enhanced": "catalog:",
    "@tanstack/router-generator": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "babel-loader": "catalog:",
    "babel-plugin-react-compiler": "catalog:"
  },
  "peerDependencies": {
    "@rsbuild/core": "catalog:",
    "@rspack/core": "catalog:",
    "@tecton/react": ">=0.1.0",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "peerDependenciesMeta": {
    "@tecton/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rsbuild/core": "catalog:",
    "@rspack/core": "catalog:",
    "@tecton/react": "link:../../../tecton-ui-1/packages/tecton-react",
    "@types/node": "catalog:",
    "postcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
