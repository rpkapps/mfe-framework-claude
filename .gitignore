node_modules/
dist/
.rspack-cache/
coverage/
*.tsbuildinfo
.DS_Store

# Generated output (§5.2.1, §10.3.1) — generated, never checked in.
routeTree.gen.ts
src/generated/
# Everything in a container's .mfe/ but the developer's own runtime configuration, which the dev
# server serves and no build ships. The contents rather than the directory, so the exception applies.
**/.mfe/*
!**/.mfe/runtime-config.json
apps/shell/public/registry.json

# Documentation site build output and the caches the TanStack Start / fumadocs pipeline keeps.
.output/
.nitro/
.tanstack/
.source/

# Local developer values (§10.6)
runtime-config.local.json
.env
.env.local

# Playwright
test-results/
playwright-report/
blob-report/

# Screenshots are for looking at a change, never for keeping: nothing asserts
# on one, so a tracked one is a stale picture of a page that has moved on.
screenshots/
